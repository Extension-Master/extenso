{
  "extends": "@extenso/config/ts/framework.json",
  "include": [
    "src/**/*.ts",
    "templates/plasmo.d.ts",
    "templates/static/**/*.ts",
    "templates/static/**/*.tsx"
  ],
  "exclude": ["dist", "node_modules"],
  "compilerOptions": {
    "outDir": "dist",
    "baseUrl": ".",
    "lib": ["es2022", "dom"],
    "jsx": "preserve",
    "types": ["node"],
    "paths": {
      "~*": ["./src/*"],
      "@plasmo-static-common/*": ["./templates/static/common/*"]
    }
  }
}
